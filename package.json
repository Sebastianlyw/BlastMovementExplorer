{
  "name": "blast-movement-explorer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "e2e": "playwright test",
    "preview": "node scripts/serve-dist.mjs 4310",
    "verify": "npm run test && npm run typecheck:e2e && npm run build && npm run build:pages && npm run e2e && openspec validate --all --strict",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "benchmark": "node scripts/benchmark.mjs",
    "build:pages": "ng build --base-href /BlastMovementExplorer/ --output-path dist/pages",
    "preview:pages": "node scripts/serve-dist.mjs 4311 --prefix=/BlastMovementExplorer/ --root=dist/pages/browser"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "three": "0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@fission-ai/openspec": "1.16.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/three": "0.186.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
